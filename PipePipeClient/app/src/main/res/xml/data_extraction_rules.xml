<?xml version="1.0" encoding="utf-8"?>
<!-- The password for backups to the user's server must not leave the device -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="remote_backup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="remote_backup.xml" />
    </device-transfer>
</data-extraction-rules>
